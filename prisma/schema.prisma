generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum LeadStatus {
  NEU
  KONTAKTIERT
  NICHT_ERREICHT
  TERMIN
  ANGEBOT_VERSENDET
  ABGESCHLOSSEN
  VERLOREN
}

enum ActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  CALL_CLICKED
  WHATSAPP_CLICKED
  EMAIL_CLICKED
  NOTE_ADDED
  REMINDER_SET
  REMINDER_DONE
}

/// Art eines geplanten Termins / einer Aufgabe zu einem Lead.
enum ReminderType {
  RUECKRUF
  ANRUF
  WHATSAPP
  EMAIL
  TERMIN
  VERTRAG
  RUECKMELDUNG
  SONSTIGES
}

enum InboundStatus {
  PROCESSED
  FAILED
  IGNORED
}

/// Das Dashboard von Function Concept, erreichbar unter /<slug> (es gibt nur noch einen Mandanten).
model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  /// E-Mail-Adressen (kommagetrennt), die bei jedem neuen Lead benachrichtigt werden.
  leadNotifyEmails String    @default("") @db.VarChar(1000)
  distributionPaused Boolean @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users         User[]
  leads         Lead[]
  stages        PipelineStage[]
  inboundEmails InboundEmail[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  username        String
  email           String
  passwordHash    String
  displayName     String
  role            Role     @default(SALES)
  active          Boolean  @default(true)
  /// Darf den Plattform-Bereich nutzen und sich in alle Mandanten einloggen.
  isPlatformAdmin Boolean  @default(false)
  /// Bekommt eine E-Mail, wenn ihm ein neuer Lead zugewiesen wird.
  notifyNewLeadEmail Boolean @default(true)
  /// Geheimer Schlüssel für den persönlichen Kalender-Abo-Link (Google Kalender "Per URL").
  calendarToken   String?  @unique @db.VarChar(64)
  // Verteilung (gewichtetes Round-Robin)
  distOrder       Int      @default(0)
  distWeight      Int      @default(1)
  distPaused      Boolean  @default(false)
  absenceReason   String?  @db.VarChar(20)
  substituteId    String?
  isTenantMaster  Boolean  @default(false)
  salesEnabled    Boolean  @default(false)
  distCurrent     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads             Lead[]
  notes             Note[]
  reminders         Reminder[]
  activities        Activity[]
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, username])
}

model Lead {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receivedAt    DateTime      @default(now())
  fullName      String?
  email         String?
  phone         String?
  language      String?
  status        LeadStatus    @default(NEU)
  rawJson       Json
  assignedToId  String?
  assignedTo    User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Phase in der Pipeline (Kanban-Ansicht). Das alte Feld "status" wird nicht mehr angezeigt.
  stageId       String?
  stage         PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  sourceEmailId String?       @unique
  sourceEmail   InboundEmail? @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  /// Provisionseinnahme in Euro, Pflicht beim Status ABGESCHLOSSEN.
  commission    Decimal?      @db.Decimal(12, 2)
  /// Zeitpunkt des Abschlusses (für die Auswertung nach Wochen/Monaten).
  closedAt      DateTime?
  /// Zeitpunkt des Anlegens in der App (receivedAt ist das Mail-Datum) – für die Live-Benachrichtigung.
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  answers    LeadAnswer[]
  notes      Note[]
  reminders  Reminder[]
  activities Activity[]

  @@index([tenantId, receivedAt])
  @@index([assignedToId, receivedAt])
  @@index([tenantId, closedAt])
  @@index([tenantId, createdAt])
  @@index([stageId])
}

/// Frei definierbare Phase der Lead-Pipeline (eine Spalte in der Kanban-Ansicht).
model PipelineStage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  position  Int
  /// Neue Leads landen in dieser Phase; sie kann nicht gelöscht werden.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  leads Lead[]

  @@index([tenantId, position])
}

model LeadAnswer {
  id            String @id @default(cuid())
  leadId        String
  lead          Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  position      Int
  questionKey   String @db.Text
  questionLabel String @db.Text
  /// Liste der Antworten (JSON-Array aus Strings)
  answers       Json

  @@index([leadId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Leer, wenn das Mitglied entfernt wurde (die Notiz bleibt erhalten).
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Reminder {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  type       ReminderType @default(RUECKRUF)
  durationMinutes Int     @default(15)
  title      String
  comment    String?   @db.Text
  done       Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, done, dueAt])
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
}

model InboundEmail {
  id         String        @id @default(cuid())
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messageId  String        @unique @db.VarChar(500)
  from       String?       @db.Text
  to         String?       @db.Text
  subject    String?       @db.Text
  receivedAt DateTime      @default(now())
  rawText    String        @db.LongText
  status     InboundStatus
  error      String?       @db.Text
  lead       Lead?

  @@index([tenantId, receivedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(700)
  keys      Json
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}
