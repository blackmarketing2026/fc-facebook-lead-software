generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum LeadStatus {
  NEU
  KONTAKTIERT
  NICHT_ERREICHT
  TERMIN
  ABGESCHLOSSEN
  VERLOREN
}

enum ActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  CALL_CLICKED
  WHATSAPP_CLICKED
  EMAIL_CLICKED
  NOTE_ADDED
  REMINDER_SET
  REMINDER_DONE
}

enum InboundStatus {
  PROCESSED
  FAILED
  IGNORED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum LeadRouteType {
  RECIPIENT
  SUBJECT
  JSON_FIELD
}

/// Ein Kunden-Dashboard (Mandant). Alle Benutzer und Leads gehören genau einem Mandanten.
model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  status        TenantStatus @default(ACTIVE)
  /// Entwicklungs-Mandant: hat automatisch alle Feature-Schalter aktiv.
  isDevelopment Boolean      @default(false)
  features      String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  domains       TenantDomain[]
  users         User[]
  leads         Lead[]
  inboundEmails InboundEmail[]
  leadRoutes    LeadRoute[]
}

model TenantDomain {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Klein geschrieben, inkl. Port bei lokalen Domains (z. B. "dev.localhost:3000").
  hostname      String    @unique
  verified      Boolean   @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
}

/// Regel, nach der eine Lead-Mail aus dem zentralen Postfach einem Mandanten zugeordnet wird.
model LeadRoute {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      LeadRouteType
  /// RECIPIENT/SUBJECT: Text, der enthalten sein muss. JSON_FIELD: "feldname=wert".
  pattern   String
  priority  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([tenantId])
}

/// Einmal-Token für den Plattform-Login in einen Mandanten ohne Passwort.
model HandoffToken {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  username        String
  email           String
  passwordHash    String
  displayName     String
  role            Role     @default(SALES)
  active          Boolean  @default(true)
  /// Darf den Plattform-Bereich nutzen und sich in alle Mandanten einloggen.
  isPlatformAdmin Boolean  @default(false)
  // Verteilung (gewichtetes Round-Robin)
  distOrder       Int      @default(0)
  distWeight      Int      @default(1)
  distPaused      Boolean  @default(false)
  distCurrent     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads             Lead[]
  notes             Note[]
  reminders         Reminder[]
  activities        Activity[]
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, username])
}

model Lead {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receivedAt    DateTime      @default(now())
  fullName      String?
  email         String?
  phone         String?
  language      String?
  status        LeadStatus    @default(NEU)
  rawJson       Json
  assignedToId  String?
  assignedTo    User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  sourceEmailId String?       @unique
  sourceEmail   InboundEmail? @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  updatedAt     DateTime      @updatedAt

  answers    LeadAnswer[]
  notes      Note[]
  reminders  Reminder[]
  activities Activity[]

  @@index([tenantId, receivedAt])
  @@index([assignedToId, receivedAt])
}

model LeadAnswer {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  position      Int
  questionKey   String
  questionLabel String
  answers       String[]

  @@index([leadId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Reminder {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  dueAt      DateTime
  title      String
  comment    String?
  done       Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, done, dueAt])
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
}

model InboundEmail {
  id         String        @id @default(cuid())
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messageId  String        @unique
  from       String?
  to         String?
  subject    String?
  receivedAt DateTime      @default(now())
  rawText    String
  status     InboundStatus
  error      String?
  lead       Lead?

  @@index([tenantId, receivedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
