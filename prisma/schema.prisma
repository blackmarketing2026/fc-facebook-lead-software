generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum LeadStatus {
  NEU
  KONTAKTIERT
  NICHT_ERREICHT
  TERMIN
  ABGESCHLOSSEN
  VERLOREN
}

enum ActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  CALL_CLICKED
  WHATSAPP_CLICKED
  EMAIL_CLICKED
  NOTE_ADDED
  REMINDER_SET
  REMINDER_DONE
}

/// Art eines geplanten Termins / einer Aufgabe zu einem Lead.
enum ReminderType {
  RUECKRUF
  ANRUF
  WHATSAPP
  EMAIL
  TERMIN
  VERTRAG
  RUECKMELDUNG
  SONSTIGES
}

enum InboundStatus {
  PROCESSED
  FAILED
  IGNORED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum LeadRouteType {
  RECIPIENT
  SUBJECT
  JSON_FIELD
}

/// Ein Kunden-Dashboard (Mandant), erreichbar unter /<slug>. Alle Benutzer und Leads gehören genau einem Mandanten.
model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique
  /// Zweistellige ID ("01"–"99", Plattform "00"). Steht sie im Betreff einer Lead-Mail, landet der Lead hier.
  code          String       @unique @db.VarChar(2)
  name          String
  status        TenantStatus @default(ACTIVE)
  /// Entwicklungs-Mandant: hat automatisch alle Feature-Schalter aktiv.
  isDevelopment Boolean      @default(false)
  /// Freigeschaltete Feature-Schlüssel, kommagetrennt (siehe src/lib/features.ts).
  features      String       @default("") @db.VarChar(1000)
  /// E-Mail-Adressen (kommagetrennt), die bei jedem neuen Lead benachrichtigt werden.
  leadNotifyEmails String    @default("") @db.VarChar(1000)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users         User[]
  leads         Lead[]
  inboundEmails InboundEmail[]
  leadRoutes    LeadRoute[]
}

/// Regel, nach der eine Lead-Mail aus dem zentralen Postfach einem Mandanten zugeordnet wird.
model LeadRoute {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      LeadRouteType
  /// RECIPIENT/SUBJECT: Text, der enthalten sein muss. JSON_FIELD: "feldname=wert".
  pattern   String        @db.VarChar(255)
  priority  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([tenantId])
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  username        String
  email           String
  passwordHash    String
  displayName     String
  role            Role     @default(SALES)
  active          Boolean  @default(true)
  /// Darf den Plattform-Bereich nutzen und sich in alle Mandanten einloggen.
  isPlatformAdmin Boolean  @default(false)
  /// Bekommt eine E-Mail, wenn ihm ein neuer Lead zugewiesen wird.
  notifyNewLeadEmail Boolean @default(true)
  /// Geheimer Schlüssel für den persönlichen Kalender-Abo-Link (Google Kalender "Per URL").
  calendarToken   String?  @unique @db.VarChar(64)
  // Verteilung (gewichtetes Round-Robin)
  distOrder       Int      @default(0)
  distWeight      Int      @default(1)
  distPaused      Boolean  @default(false)
  distCurrent     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads             Lead[]
  notes             Note[]
  reminders         Reminder[]
  activities        Activity[]
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, username])
}

model Lead {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receivedAt    DateTime      @default(now())
  fullName      String?
  email         String?
  phone         String?
  language      String?
  status        LeadStatus    @default(NEU)
  rawJson       Json
  assignedToId  String?
  assignedTo    User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  sourceEmailId String?       @unique
  sourceEmail   InboundEmail? @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  /// Zeitpunkt des Anlegens in der App (receivedAt ist das Mail-Datum) – für die Live-Benachrichtigung.
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  answers    LeadAnswer[]
  notes      Note[]
  reminders  Reminder[]
  activities Activity[]

  @@index([tenantId, receivedAt])
  @@index([assignedToId, receivedAt])
  @@index([tenantId, createdAt])
}

model LeadAnswer {
  id            String @id @default(cuid())
  leadId        String
  lead          Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  position      Int
  questionKey   String @db.Text
  questionLabel String @db.Text
  /// Liste der Antworten (JSON-Array aus Strings)
  answers       Json

  @@index([leadId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Reminder {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  dueAt      DateTime
  type       ReminderType @default(RUECKRUF)
  durationMinutes Int     @default(15)
  title      String
  comment    String?   @db.Text
  done       Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, done, dueAt])
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
}

model InboundEmail {
  id         String        @id @default(cuid())
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messageId  String        @unique @db.VarChar(500)
  from       String?       @db.Text
  to         String?       @db.Text
  subject    String?       @db.Text
  receivedAt DateTime      @default(now())
  rawText    String        @db.LongText
  status     InboundStatus
  error      String?       @db.Text
  lead       Lead?

  @@index([tenantId, receivedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(700)
  keys      Json
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}
